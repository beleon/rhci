# The standalone rhci command. mrblib/rhci.rb is generated by
# `rake bundle` from lib/ (see lib/rhci/manifest.txt); never edit it.
MRuby::Gem::Specification.new('rhci') do |spec|
  spec.license = 'MIT'
  spec.author  = 'Leon Becker'
  spec.summary = 'rhci: a GHCi-like Haskell REPL'
  spec.bins = %w(rhci)
  # Rhci::Term must exist before the bundle's Shim is loaded.
  spec.add_dependency 'rhci-native'
end
