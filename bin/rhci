#!/usr/bin/env ruby
# frozen_string_literal: true

# CRuby launcher; the mruby build is build/rhci/bin/rhci. The evaluation
# loop runs about 1.7x faster under YJIT (the library leaves that choice
# to the embedding program).
RubyVM::YJIT.enable if defined?(RubyVM::YJIT) && RubyVM::YJIT.respond_to?(:enable)
require_relative '../lib/rhci'
exit Rhci::CLI.main(ARGV)
